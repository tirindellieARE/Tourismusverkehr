# 3. Clean names: Ä -> Ae, ü -> ue, é -> e, spaces -> _
clean <- function(x) {
x <- stringi::stri_trans_general(x, "de-ASCII; Latin-ASCII")
gsub("[^A-Za-z0-9]+", "_", x)
}
