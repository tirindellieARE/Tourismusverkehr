# --- Project root ------------------------------------------------------------
cfg <- yaml::read_yaml("Scripts/02_travel_time/config.yml")
# --- Helper: ensure a directory exists --------------------------------------
ensure_dir <- function(path) {
if (!dir.exists(path)) dir.create(path, recursive = TRUE, showWarnings = FALSE)
invisible(path)
}
ensure_dir("data/input")
ensure_dir("data/output")
ensure_dir("data/osm")
ensure_dir("data/gtfs")
# --- Helper: timestamped logging --------------------------------------------
log_msg <- function(...) {
cat(sprintf("[%s] %s\n", format(Sys.time(), "%H:%M:%S"), paste0(...)))
}
# --- Helper: build a stable pair key ----------------------------------------
# Rounds coordinates to 6 dp so identical points collapse consistently.
make_pair_key <- function(olat, olon, glat, glon) {
sprintf("%.6f_%.6f_%.6f_%.6f",
round(olat, 6), round(olon, 6),
round(glat, 6), round(glon, 6))
}
log_msg("Setup complete. Config loaded from config.yml.")
# ============================================================
# 01_filter.R
# 1. Read the raw trip CSV (Latin-1).
# 2. Drop origins that fall INSIDE Switzerland (point-in-polygon).
# 3. Extract unique origin -> grenz pairs (the routing workload).
# 4. Write pairs_to_route.csv and row_to_pair.csv.
#
# Run:  source("R/00_setup.R"); source("R/01_filter.R")
# ============================================================
source("R/00_setup.R")
source("Scripts/02_travel_time/00_setup.R")
# ============================================================
# 01_filter.R
# 1. Read the raw trip CSV (Latin-1).
# 2. Drop origins that fall INSIDE Switzerland (point-in-polygon).
# 3. Extract unique origin -> grenz pairs (the routing workload).
# 4. Write pairs_to_route.csv and row_to_pair.csv.
#
# Run:  source("R/00_setup.R"); source("R/01_filter.R")
# ============================================================
source("Scripts/02_travel_time/00_setup.R")
# --- Download the Switzerland boundary if not present ------------------------
ch_geojson <- "data/input/ne_countries.geojson"
if (!file.exists(ch_geojson)) {
log_msg("Downloading country boundaries for CH polygon ...")
utils::download.file(cfg$ch_boundary_url, ch_geojson, mode = "wb", quiet = TRUE)
}
ch <- sf::st_read(ch_geojson, quiet = TRUE)
# Natural Earth uses ADMIN; fall back to NAME if needed.
name_col <- intersect(c("ADMIN", "NAME", "SOVEREIGNT"), names(ch))[1]
ch_poly <- ch[ch[[name_col]] == cfg$ch_admin_name, ]
if (nrow(ch_poly) == 0) stop("Could not find Switzerland in the boundary file.")
ch_poly <- sf::st_geometry(sf::st_make_valid(ch_poly))
log_msg("Switzerland polygon loaded.")
# --- Read the raw trip data --------------------------------------------------
cn <- cfg$cols
raw <- readr::read_delim(
cfg$input_csv,
delim = ",",
locale = readr::locale(encoding = cfg$input_encoding),
show_col_types = FALSE
)
